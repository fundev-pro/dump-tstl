{
    "name": "dump-tstl",
    "version": "1.0.0",
    "description": "Debug utilities for TypeScript-to-Lua projects: pretty-print Lua tables with dump() and inspect() functions",
    "keywords": ["typescript-to-lua", "tstl", "lua", "debug", "dump", "inspect"],
    "homepage": "https://github.com/fundev-pro/dump-tstl#readme",
    "bugs": {
        "url": "https://github.com/fundev-pro/dump-tstl/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fundev-pro/dump-tstl.git"
    },
    "type": "module",
    "scripts": {
        "start": "npm run build",
        "build": "tstl -p tsconfig.json",
        "clean": "rimraf dist tsconfig.tsbuildinfo",
        "rebuild": "npm run clean && npm run build",
        "prepare-dist": "tsx scripts/prepare-dist.ts",
        "prepublishOnly": "npm run rebuild && npm run prepare-dist",
        "format": "prettier --write \"**/*.{ts,json}\"",
        "format:check": "prettier --check \"**/*.{ts,json}\"",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "pack": "npm run prepublishOnly && cd dist && npm pack"
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.lua",
    "license": "ISC",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.48.0",
        "@typescript-eslint/parser": "^8.48.0",
        "@typescript-to-lua/language-extensions": "1.19.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-unicorn": "^62.0.0",
        "jsonc-parser": "^3.3.1",
        "lua-types": "^2.13.1",
        "rimraf": "^6.1.2",
        "tsx": "^4.19.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.0",
        "typescript-to-lua": "^1.33.0"
    }
}
